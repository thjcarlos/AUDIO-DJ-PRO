<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#090D16"
    android:padding="12dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:text="AUDIO DJ PRO" android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="22sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/statusText" android:text="CARGANDO MOTOR DE AUDIO"
            android:textColor="#13B8A6" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
        <LinearLayout android:orientation="vertical" android:background="#14283D" android:padding="12dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <TextView android:text="DECK A  /  AUDIO BASE" android:textColor="#55B8FF" android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/baseName" android:text="Selecciona tu audio base" android:textColor="#FFFFFF"
                android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/baseTime" android:text="00:00" android:textColor="#55B8FF" android:textSize="28sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <TextView android:text="REPRODUCCIÓN EN BUCLE" android:textColor="#9FC9E8" android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <SeekBar android:id="@+id/baseVolume" android:progress="75" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/chooseBase" android:text="CARGAR AUDIO BASE" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        </LinearLayout>
        <View android:layout_width="8dp" android:layout_height="match_parent"/>
        <LinearLayout android:orientation="vertical" android:background="#2A1C38" android:padding="12dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <TextView android:text="DECK B  /  TRACK" android:textColor="#D69AFF" android:textStyle="bold" android:textSize="15sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/trackName" android:text="Selecciona una canción" android:textColor="#FFFFFF"
                android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/trackTime" android:text="00:00" android:textColor="#D69AFF" android:textSize="28sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <TextView android:text="REPRODUCCIÓN ÚNICA" android:textColor="#D8BCEB" android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <SeekBar android:id="@+id/trackVolume" android:progress="100" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <Button android:id="@+id/playTrack" android:text="▶ PLAY" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <Button android:id="@+id/stopTrack" android:text="■ STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp">
        <TextView android:text="BIBLIOTECA DE AUDIOS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/addTracks" android:text="+ AGREGAR AUDIOS" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ListView android:id="@+id/trackList" android:divider="#273044" android:dividerHeight="1dp"
        android:background="#111827" android:layout_width="match_parent" android:layout_height="112dp"/>
    <TextView android:text="Al terminar un track, el audio base vuelve automáticamente. La reproducción continúa en segundo plano."
        android:textColor="#8D9AAF" android:textSize="10sp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp"/>
</LinearLayout>
